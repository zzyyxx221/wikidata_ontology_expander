      constraint: MultiValue


 


# ======================================================
# 文档域
# ======================================================

DataSource(数据来源): EntityType
  properties:
    #modules: source_properties
    name(名称): Text
      index: Text
    description(描述): Text
      index: Text
    confidence(置信度): Float

Document(文档): EntityType
  properties:
    #modules: common_properties
    name(名称): Text
      index: Text
    officialName(标准名称): Text
    shortName(简称): Text
      index: Text
    description(描述): Text
      index: Text
    author(作者): Text
      index: Text
    publishOrganization(发布机构): Text
      index: Text
    fileId(文件ID): Text
      index: Text
    #modules: document_properties
    category(分类): DocumentCategory
      constraint: MultiValue
    publishTime(发布时间): STD.Timestamp

  relations:
    #modules: source_relations
    source(来源): DataSource

Chunk(文本块): IndexType
  properties:
    #modules: chunk_properties
    name(名称): Text
    sort(排序): Integer
    description(描述): Text
    content(内容): Text
      index: TextAndVector
  relations:
    #modules: source_relations
    sourceDocument(来源文档): Document
