Index(指标): EntityType
  properties:
    #modules: common_properties
    name(名称): Text
      index: Text
    officialName(标准名称): Text
    shortName(简称): Text
      index: Text
    alias(别名): Text
      constraint: MultiValue
      index: Text
    description(描述): Text
      index: Text

    #modules: index_properties
